{
  "id": "org.figcraft.tools.image-trace",
  "name": "Image Trace",
  "version": "1.0.0",
  "description": "Trace bitmap images to editable vector paths or isolated masks.",
  "main": "image_trace.wasm",
  "api": 2,
  "permissions": {
    "access": "write",
    "commands": ["image.trace"]
  },
  "commands": [
    { "id": "panel", "label": "Image Trace…" },
    {
      "id": "apply",
      "label": "Trace Image",
      "params": [
        { "name": "mode", "label": "Mode", "type": "list", "options": ["monochrome", "color"], "default": "monochrome" },
        { "name": "threshold", "label": "Threshold", "type": "number", "default": 128, "min": 0, "max": 255 },
        { "name": "invert", "label": "Invert", "type": "boolean", "default": false },
        { "name": "colors", "label": "Max colors", "type": "number", "default": 8, "min": 2, "max": 16 },
        { "name": "alphaCutoff", "label": "Alpha cutoff", "type": "number", "default": 16, "min": 1, "max": 255 },
        { "name": "resolution", "label": "Resolution", "type": "number", "default": 256, "min": 16, "max": 512 },
        { "name": "output", "label": "Output", "type": "list", "options": ["vectors", "mask"], "default": "vectors" }
      ]
    }
  ]
}
